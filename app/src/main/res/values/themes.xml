<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SemaVoice" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.SemaVoice.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sema_light_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SemaVoice</item>
    </style>
</resources>
